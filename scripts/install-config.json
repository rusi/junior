{
  "directories": [
    "~/.codex",
    "~/.codex/rules",
    "~/.codex/skills"
  ],
  "files": [
    {
      "source": "AGENTS.md",
      "destination": "~/.codex/AGENTS.md"
    },
    {
      "source": "agents/rules/",
      "destination": "~/.codex/rules/",
      "isDirectory": true
    },
    {
      "source": "agents/skills/",
      "destination": "~/.codex/skills/",
      "isDirectory": true
    },
    {
      "source": "README.md",
      "destination": "~/.codex/skills/jr/references/junior-readme.md"
    }
  ],
  "messages": {
    "welcome": "Installing Junior global assets...",
    "success": "Junior global installation complete!",
    "nextSteps": [
      "Verify ~/.codex/AGENTS.md is loaded by your assistant runtime",
      "Use jr-init to establish project foundation",
      "Use /jr update for framework updates"
    ],
    "availableCommands": "Global skills under ~/.codex/skills: jr, jr-init, jr-roadmap, jr-feature, jr-add-story, jr-implement, jr-test, jr-commit, jr-code-review, jr-debug, jr-refactor, jr-status, jr-next, jr-new-command"
  },
  "targets": {
    "cursor": {
      "directories": [
        "~/.cursor/rules",
        "~/.cursor/commands",
        "~/.cursor/commands/_shared"
      ],
      "files": [
        {
          "source": "agents/rules/",
          "destination": "~/.cursor/rules/",
          "isDirectory": true
        },
        {
          "source": "cursor/rules/",
          "destination": "~/.cursor/rules/",
          "isDirectory": true
        },
        {
          "source": "agents/skills/",
          "destination": "~/.cursor/commands/",
          "mode": "skill_markdown_commands"
        },
        {
          "source": "agents/skills/",
          "destination": "~/.cursor/commands/_shared/",
          "mode": "skill_support_tree"
        },
        {
          "source": "README.md",
          "destination": "~/.cursor/commands/_shared/junior-readme.md"
        }
      ],
      "messages": {
        "success": "Junior global Cursor installation complete!",
        "nextSteps": [
          "Verify Cursor exposes /jr and /jr-* workflows",
          "Verify Junior rules are available to Cursor",
          "Use /jr-init to establish project foundation",
          "Use /jr update --target cursor for framework updates"
        ],
        "availableCommands": "Global commands under ~/.cursor/commands: jr, jr-init, jr-roadmap, jr-feature, jr-add-story, jr-implement, jr-test, jr-commit, jr-code-review, jr-debug, jr-refactor, jr-status, jr-next, jr-new-command"
      }
    }
  }
}
