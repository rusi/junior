{
  "targets": {
    "claude": {
      "directories": [
        "~/.claude",
        "~/.claude/rules",
        "~/.claude/skills",
        "~/.claude/hooks"
      ],
      "files": [
        {
          "source": "agents/contracts/claude.md",
          "destination": "~/.claude/junior-contract.md"
        },
        {
          "source": "agents/rules/",
          "destination": "~/.claude/rules/",
          "isDirectory": true
        },
        {
          "source": "agents/skills/",
          "destination": "~/.claude/skills/",
          "isDirectory": true
        },
        {
          "source": "agents/hooks/",
          "destination": "~/.claude/hooks/",
          "isDirectory": true
        },
        {
          "source": "README.md",
          "destination": "~/.claude/skills/jr/references/junior-readme.md"
        }
      ],
      "messages": {
        "welcome": "Installing Junior assets...",
        "success": "Junior installation complete!",
        "nextSteps": [
          "Start a new Claude Code session to load Junior's native rules",
          "Use jr-init to establish project foundation",
          "Use /jr update for framework updates"
        ]
      }
    },
    "cursor": {
      "directories": [
        "~/.cursor/rules",
        "~/.agents/skills"
      ],
      "files": [
        {
          "source": "agents/rules/",
          "destination": "~/.cursor/rules/",
          "mode": "cursor_rules"
        },
        {
          "source": "agents/skills/",
          "destination": "~/.agents/skills/",
          "isDirectory": true
        },
        {
          "source": "README.md",
          "destination": "~/.agents/skills/jr/references/junior-readme.md"
        }
      ],
      "messages": {
        "success": "Junior Cursor installation complete!",
        "nextSteps": [
          "Verify Cursor exposes /jr and /jr-* workflows",
          "Verify Junior rules are available to Cursor",
          "Use /jr-init to establish project foundation",
          "Use /jr update --target cursor for framework updates"
        ]
      }
    },
    "codex": {
      "directories": [
        "~/.agents/skills",
        "~/.agents/rules"
      ],
      "files": [
        {
          "source": "agents/rules/",
          "destination": "~/.agents/rules/",
          "isDirectory": true
        },
        {
          "source": "agents/skills/",
          "destination": "~/.agents/skills/",
          "isDirectory": true
        },
        {
          "source": "README.md",
          "destination": "~/.agents/skills/jr/references/junior-readme.md"
        }
      ],
      "messages": {
        "success": "Junior Codex assets prepared!",
        "nextSteps": [
          "Start a new Codex session to load Junior's complete rules through AGENTS.md.",
          "Project installs require a trusted project so Codex loads its instruction capacity setting."
        ]
      }
    }
  }
}
